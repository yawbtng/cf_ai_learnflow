# Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# Cloudflare Worker URL (set after deploying the worker)
NEXT_PUBLIC_WORKER_URL=https://your-worker.your-subdomain.workers.dev

# Worker Environment Variables
# For local development: Create worker/.env file with these variables
# For production: Set these in Cloudflare Dashboard -> Workers & Pages -> Your Worker -> Settings -> Variables
# Or use: wrangler secret put <VARIABLE_NAME>

# YouTube Data API v3
# Get from: https://console.cloud.google.com/
YOUTUBE_API_KEY=your_youtube_api_key_here

# Spotify Web API
# Get from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# NewsData.io API
# Get from: https://newsdata.io/
NEWSDATA_API_KEY=your_newsdata_api_key_here

# Cloudflare Account ID
# Get from: https://dash.cloudflare.com -> Right sidebar
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
